# Fusion Strike AI network-wide IDS/IPS deployment profile examples.
# Copy the relevant keys into .env and adjust interface names/IPs for your lab.

# ------------------------------
# Sensor visibility profile
# ------------------------------
# host   = sees traffic to/from Fusion only
# span   = managed switch port mirroring / SPAN destination
# tap    = passive TAP feed
# inline = Fusion is in the forwarding path
SENSOR_MODE=span

# Windows examples: Ethernet, Wi-Fi
# Linux examples: eth0, ens33, enp0s3
CAPTURE_INTERFACE=Ethernet

# Promiscuous mode helps accept mirrored traffic that is not addressed to Fusion.
# It does not bypass switch forwarding by itself.
PROMISCUOUS_MODE=true

# ------------------------------
# IPS enforcement profile
# ------------------------------
# database         = dashboard/database state only
# local_firewall   = Windows Firewall / Linux INPUT chain on Fusion machine
# gateway_firewall = Linux FORWARD chain when Fusion controls a gateway/firewall
# inline           = Linux FORWARD chain when Fusion is inline
IPS_MODE=local_firewall

# windows uses netsh advfirewall on the Fusion host.
# auto chooses windows on Windows, nftables if available on Linux, then iptables.
# Allowed: auto, windows, iptables, nftables
FIREWALL_BACKEND=windows

IPS_VERIFY_TIMEOUT_SEC=5

# ------------------------------
# Graduation demo examples
# ------------------------------
# SPAN detection, database-only prevention proof:
# SENSOR_MODE=span
# IPS_MODE=database
#
# Victim-host demo with real local firewall block:
# SENSOR_MODE=host
# IPS_MODE=local_firewall
# FIREWALL_BACKEND=windows
#
# Inline gateway IPS demo on Linux:
# SENSOR_MODE=inline
# IPS_MODE=inline
# FIREWALL_BACKEND=iptables
