# IDS/IPS SOC Dashboard — Frontend Environment Variables
#
# This file is read by Vite at dev-server startup.
# Change VITE_API_BASE_URL if your Flask API runs on a different host/port.
#
# Leave blank to follow the current browser hostname automatically.
# Example override: VITE_API_BASE_URL=http://192.168.1.50:5000
VITE_API_BASE_URL=
