# Fusion Strike AI backend configuration example.
# Copy to .env and replace secrets before running a shared environment.

DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ids_system

API_HOST=127.0.0.1
API_PORT=5000
API_TOKEN=dev-api-token-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me-at-least-32-bytes
ADMIN_INVITE_KEY=admin-1913
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://10.0.2.2:5173,null

PENTEST_MODE=lab
ALLOW_INTERNAL_SCAN=true
ALLOW_ALL_TARGETS=true
NMAP_ENABLED=true

SENSOR_MODE=host
CAPTURE_INTERFACE=
PROMISCUOUS_MODE=true

IPS_MODE=local_firewall
FIREWALL_BACKEND=windows
IPS_VERIFY_TIMEOUT_SEC=5
